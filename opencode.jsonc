{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",

  // Superpowers is the only vendored package that exports an OpenCode plugin.
  "plugin": [
    "./.opencode/vendor/superpowers"
  ],

  // Remaining vendor packs are skill collections, not plugins.
  "skills": {
    "paths": [
      ".opencode/vendor/marketingskills/skills",
      ".opencode/vendor/ui-ux-pro-max/.claude/skills",
      ".opencode/vendor/opencode-seo-architect/.opencode/skills",
      ".opencode/vendor/emilkowalski-skills/skills",
      ".opencode/vendor/shadcn-ui/skills",
      ".opencode/vendor/vercel-agent-skills/skills",
      ".opencode/vendor/agent-browser/skills",
      ".opencode/vendor/agent-browser/skill-data"
    ]
  },

  "references": {
    "i18n-locales": {
      "path": "./shared/locales",
      "description": "Indian regional (Hindi, Tamil, Telugu, Marathi, Gujarati, Bengali) and global locale translation keys"
    },
    "tool-templates": {
      "path": "./shared/templates",
      "description": "Client-side hyper-niche utility tool boilerplates"
    }
  },

  // Last matching bash pattern wins; keep "*" first, then allowlists.
  "permission": {
    "task": "allow",
    "question": "allow",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "bun *": "allow",
      "agent-browser *": "allow"
    }
  }
}
